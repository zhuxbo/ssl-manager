# 默认无需此文件：make up 使用本机 MySQL。
# 使用外部数据库：复制为根目录 .env，填写连接信息，然后 make build && make up。
# Compose 需要支持 !override（2.24.4+）。
COMPOSE_FILE=compose.yaml:compose.external-db.yaml
DEV_DB_HOST=192.168.3.100
DEV_DB_PORT=3306
DEV_DB_USERNAME=ssl_manager
# 建议使用随机字母数字密码；若含 $，用单引号包裹以禁止 Compose 插值。
DEV_DB_PASSWORD='replace-with-your-password'
